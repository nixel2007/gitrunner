{
    "version": "2.0.0",
    "command": "oscript",
    "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
    },
    "args": [
        "-encoding=utf-8"
    ],
    "tasks": [
        {
            "type": "shell",
            "label": "Exec all features",
            "command":[
                "1bdd"
            ],
            "args": [
                "${workspaceRoot}/features",
                "-fail-fast",
                "-out",
                "${workspaceRoot}/exec.log"
            ],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "group": "test",
            "problemMatcher": {
                "fileLocation": "absolute",
                "pattern": {
                    "regexp": "{Модуль\\s+(.+)\\s\\/\\s.*:\\s+(\\d+)\\s+\\/\\s+([^{]*)",
                    "file": 1,
                    "location": 2,
                    "message": 3
                }
            }
        },
        {
            "type": "shell",
            "label": "Exec feature",
            "command":[
                "1bdd"
            ],
            "args": [
                "${file}",
                "-fail-fast",
                "-out",
                "${workspaceRoot}/exec.log"
            ],
            "presentation": {
            "echo": true,
            "reveal": "always",
            "focus": false,
            "panel": "shared",
            "showReuseMessage": true,
            "clear": false
           },
           "group": "test",
            "problemMatcher": {
                "fileLocation": "absolute",
                "pattern": [
                    {
                        "regexp": "{Модуль\\s+(.+)\\s\\/\\s.*:\\s+(\\d+)\\s+\\/\\s+([^{]*)",
                        "file": 1,
                        "location": 2,
                        "message": 3
                    }
                ]
            }
        },
        {
            "type": "shell",
            "label": "Exec feature + debug",
            "command":[
                "1bdd"
                
            ],
            "args": [
                "${file}",
                "-fail-fast",
                "-verbose",
                "on",
                "-out",
                "${workspaceRoot}/exec.log"
            ],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "group": "test",
            "problemMatcher": {
                "fileLocation": "absolute",
                "pattern": {
                    "regexp": "{Модуль\\s+(.+)\\s\\/\\s.*:\\s+(\\d+)\\s+\\/\\s+([^{]*)",
                    "file": 1,
                    "location": 2,
                    "message": 3
                }
            }
        },
        {
            "type": "shell",
            "label": "Generate feature steps",
            "command":[
                "1bdd"
            ],
            "args": [
                "gen",
                "${file}",
                // "-verbose", 
                // "on", 
                "-out",
                "${workspaceRoot}/exec.log"
            ],
            "presentation": {
            "echo": true,
            "reveal": "always",
            "focus": false,
            "panel": "shared",
            "showReuseMessage": true,
            "clear": false
           },
            "group": "build",
            "problemMatcher": {
                "fileLocation": "absolute",
                "pattern": {
                    "regexp": "{Модуль\\s+(.+)\\s\\/\\s.*:\\s+(\\d+)\\s+\\/\\s+([^{]*)",
                    "file": 1,
                    "location": 2,
                    "message": 3
                }
            }
        },
        {
            "type": "shell",
            "label": "Generate feature steps + debug",
            "command":[
                "1bdd"
            ],
            "args": [
                "gen",
                "${file}",
                "-verbose",
                "on",
                "-out",
                "${workspaceRoot}/gen.log"
            ],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "group": "build",
            "problemMatcher": {
                "fileLocation": "absolute",
                "pattern": {
                    "regexp": "{Модуль\\s+(.+)\\s\\/\\s.*:\\s+(\\d+)\\s+\\/\\s+([^{]*)",
                    "file": 1,
                    "location": 2,
                    "message": 3
                }
            }
        },
        {
            "type": "shell",
            "label": "OneScript: compile",
            "command":[
                "oscript"
            ],
            "args": [
                "-compile",
                "${file}"
            ],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "group": "test",
        },
        {
            "type": "shell",
            "label": "OneScript: check",
            "command":[
                "oscript"
            ],
            "args": [
                "-check",
                "${file}"
            ],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "group": "test",
        },
        {
            "type": "shell",
            "label": "OneScript: make",
            "command":[
                "oscript"
            ],
            "args": [
                "-make",
                "${file}",
                "${fileBasename}.exe"
            ],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "group": "test",
        },
        {
            "type": "shell",
            "label": "OneScript: run",
            "command":[
                "oscript"
            ],
            "args": [
                "${file}"
            ],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "group": "build",
            "problemMatcher": {
                "fileLocation": "absolute",
                "pattern": {
                    "regexp": "^{Модуль\\s+(.*)\\s\\/\\s.*:\\s+(\\d+)\\s+\\/\\s+(.*)}$",
                    "file": 1,
                    "location": 2,
                    "message": 3
                }
            }
        }
    ]
}